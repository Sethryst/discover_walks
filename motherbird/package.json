{
  "name": "walk-wildlife-journal-vienna",
  "version": "1.0.0",
  "type": "module",
  "description": "A mobile-first, local-first walking journal that introduces historic places as a person moves through Vienna, VA or a Norfolk, VA prototype layer. It includes walk recording, geofenced historic prompts, personal reflections, geotagged nature observations, and a local points profile. The default experience has no account, server, analytics, or paid backend.",
  "main": "app.js",
  "scripts": {
    "build": "node tools/build-pages.mjs",
    "build:kpi": "node tools/build-kpi-index.mjs",
    "build:vienna-osm": "node tools/build-vienna-osm-pois.mjs vienna",
    "build:municipal-seeds": "node tools/export-municipal-pois.mjs",
    "check:municipal-seeds": "node tools/export-municipal-pois.mjs --check",
    "build:osm-city": "node tools/build-vienna-osm-pois.mjs",
    "build:osm-regions": "node tools/build-osm-regional-packages.mjs",
    "publish:missing-region-seeds": "node tools/publish-missing-region-seeds.mjs",
    "audit:endpoints": "node tools/audit-endpoint-registrations.mjs",
    "audit:endpoints:live": "node tools/audit-endpoint-registrations.mjs --live --record",
    "test": "node --test tests/*.test.mjs",
    "audit:imports": "node tools/audit-imports.mjs",
    "sync:gremlin-geography": "node tools/sync-gremlin-geography.mjs",
    "sync:gremlin-pois": "node tools/sync-gremlin-pois.mjs",
    "sync:gremlin-journeys": "node tools/sync-gremlin-journeys.mjs",
    "verify:gremlin": "node tools/verify-gremlin-inventory.mjs",
    "build:civic-packages": "node tools/build-civic-packages.mjs",
    "verify:dc-sources": "node tools/dc-sources/fetch-all.mjs --verify-only",
    "fetch:dc-sources": "node tools/dc-sources/fetch-all.mjs",
    "refresh:dc-official-trails": "node tools/refresh-dc-official-trails.mjs",
    "refresh:appalachian-lab": "node tools/refresh-appalachian-corridor-lab.mjs",
    "research:appalachian-lab": "node tools/build-appalachian-research-package.mjs",
    "report:appalachian-research": "node tools/build-appalachian-research-report.mjs",
    "check:appalachian-lab": "node tools/region-build.mjs appalachian-corridor-lab --dry-run",
    "build:dc-pois": "node tools/build-dc-pois.mjs",
    "build:dc-boundaries": "node tools/build-dc-boundary-artifacts.mjs",
    "build:federal-core": "node tools/build-federal-core.mjs",
    "build:federal-core:national": "node tools/build-federal-core.mjs --national",
    "build:federal-regions": "node tools/build-federal-regions.mjs",
    "tag:federal-pois": "node tools/tag-pois-with-federal-regions.mjs",
    "publish:federal-regions": "node tools/export-federal-region-runtime.mjs",
    "build:spatial-index": "node tools/build-spatial-index.mjs",
    "check:spatial-sync": "node tools/check-spatial-sync-readiness.mjs",
    "validate:dc-pois": "node tools/validate-dc-pois.mjs",
    "inspect:dc-pois": "node tools/inspect-dc-pois.mjs",
    "dev:dc-region": "node tools/dev-dc-region.mjs",
    "test:dc-pipeline": "node --test tests/dc-poi-pipeline.test.mjs",
    "test:fetch-parks": "node tools/dc-sources/fetch-all.mjs --verify-only",
    "test:normalize": "node --test --test-name-pattern=normalize tests/dc-poi-pipeline.test.mjs",
    "test:geocode": "node --test --test-name-pattern=geocoding tests/dc-poi-pipeline.test.mjs",
    "test:assign-neighborhoods": "node --test --test-name-pattern=neighborhood tests/dc-poi-pipeline.test.mjs",
    "test:deduplicate": "node --test --test-name-pattern=deduplication tests/dc-poi-pipeline.test.mjs",
    "test:validate": "node --test --test-name-pattern=validation tests/dc-poi-pipeline.test.mjs",
    "test:offline-pois": "node --test tests/dc-offline-pois.test.mjs",
    "test:poi-render-performance": "node --test tests/dc-poi-performance.test.mjs",
    "audit:poi": "node tools/audit-poi-tags.mjs",
    "build:region": "node tools/region-build.mjs",
    "build:region:legacy": "node tools/build-region.mjs",
    "build:regions": "npm run build:region norfolk && npm run build:region new-york-city && npm run build:region philadelphia && npm run build:region richmond && npm run build:region washington-dc && npm run build:region keystone-colorado && npm run build:region prince-georges-county && npm run build:region sedona-arizona && npm run build:region boise-meridian-idaho && npm run build:region vienna",
    "build:field-editions": "node tools/field-edition-build.mjs meadowlark-gardens",
    "build:field-edition": "node tools/field-edition-build.mjs",
    "test:field-editions": "node tests/field-edition.test.mjs",
    "test:seasonal-awareness": "node tests/seasonal-awareness.test.mjs",
    "test:producer-poi-display": "node tests/producer-poi-display.test.mjs",
    "test:regional-filters": "node tests/regional-poi-filtering.test.mjs",
    "test:regions": "node tests/boundary-resolver.test.mjs && node tests/region-runtime.test.mjs",
    "test:region-packages": "node tests/region-package-output.test.mjs",
    "test:civic-ui": "node tests/civic-ui.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sethryst/walk-wildlife.git"
  },
  "keywords": [],
